# Cifragem de segredos em repouso (AES-256-GCM, server only)
# Chave de 32 bytes em base64 — gerar com: openssl rand -base64 32
# Configurar no Vercel (Settings → Environment Variables) em Production e
# Preview. Sem ela, salvar integrações FALHA de forma explícita (nunca grava
# segredo em claro) e os tokens antigos em claro continuam funcionando.
APP_ENCRYPTION_KEY=

# Supabase
# SUPABASE_URL is required by production server functions (same project as VITE_SUPABASE_URL).
# Configure both SUPABASE_URL and TECH_SUPABASE_SERVICE_KEY in Vercel Production and Preview.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
TECH_SUPABASE_SERVICE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Public site URLs
VITE_SITE_URL=http://localhost:3000
HOTSPOT_LOGIN_HOST=
PROJECT_URL=

# MikroTik / RADIUS (server only)
HOTSPOT_CREDENTIAL_SECRET=
HOTSPOT_LEGACY_HEARTBEAT_TOKEN=
MIKROTIK_RADIUS_HOST=
MIKROTIK_RADIUS_SECRET=
RADIUS_API_TOKEN=

# Scheduled jobs and operational integrations (server only)
CRON_SECRET=
OPERATIONAL_JOB_SECRET=
ASAAS_MANAGER_SECRET=
ASAAS_WEBHOOK_TOKEN=

# Optional AI and data enrichment integrations (server only)
DEEPSEEK_API_KEY=
TAVILY_API_KEY=
PHONEVALIDATION_API_KEY=
TRUEGUARD_API_KEY=

# Web Push do bate-papo (servidor + navegador)
# Gerar com: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY e VAPID_PRIVATE_KEY: Production e Preview na Vercel.
# VITE_VAPID_PUBLIC_KEY: mesma pública, vai para o navegador no build.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VITE_VAPID_PUBLIC_KEY=

# Cloudflare Turnstile (anti-bot, grátis) — item 12 da auditoria de segurança.
# Criar o site em https://dash.cloudflare.com/turnstile e configurar as
# duas chaves no Vercel (Production e Preview). A site key é pública (vai
# para o navegador no build); a secret key é SÓ servidor — nunca commitar
# valores reais aqui, só os nomes das variáveis.
# TURNSTILE_SECRET_KEY: secret key do site Turnstile (server only).
TURNSTILE_SECRET_KEY=
# VITE_TURNSTILE_SITE_KEY: site key do site Turnstile (pública, navegador).
VITE_TURNSTILE_SITE_KEY=

# VERCEL_URL is supplied automatically by Vercel.
