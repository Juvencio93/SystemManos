{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:verified",
  "installCommand": "npm ci --prefer-offline",
  "crons": [
    {
      "path": "/api/public/billing-access-sync",
      "schedule": "5 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/portal/(demo-barao|demo-efraim)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=86400" }]
    },
    {
      "source": "/((?!assets/|portal/demo-barao|portal/demo-efraim).*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
